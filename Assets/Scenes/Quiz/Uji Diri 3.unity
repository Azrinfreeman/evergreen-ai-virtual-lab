--- !u!114 &1026078785
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1026078783}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ce927798c407524d9f3e6481e7604ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionlist:
  - question:
    - Antara berikut, yang manakah merupakan contoh bakteria baik yang terdapat dalam usus manusia?
    QuestionOnAnswersBtn:
    - answer:
      - Lactobacillus
      - Salmonella
      - Staphylococcus
      - Clostridium botulinum
      answeOnBtn: 0
  - question:
    - Antara bakteria ini yang manakah bertanggungjawab menyebabkan keracunan makanan?
    QuestionOnAnswersBtn:
    - answer:
      - Bifidobacterium
      - Salmonella
      - Rhizobium
      - Bacillus subtilis
      answeOnBtn: 1
  - question:
    - Apakah peranan utama bakteria pengikat nitrogen dalam alam sekitar?
    QuestionOnAnswersBtn:
    - answer:
      - Memecahkan bahan organik
      - Memperbaiki nitrogen atmosfera kepada bentuk yang boleh digunakan oleh tumbuhan
      - Plastik mereput
      - Menyebabkan penyakit pada tumbuhan
      answeOnBtn: 1
  - question:
    - Apakah faedah utama probiotik?
    QuestionOnAnswersBtn:
    - answer:
      - Meningkatkan penyerapan nutrien dalam usus
      - Menyebabkan jangkitan untuk menguatkan imuniti
      - Meningkatkan keasidan perut
      - Menghasilkan toksin berbahaya untuk membunuh patogen
      answeOnBtn: 0
  - question:
    - Bagaimanakah bakteria baik membantu dalam usus manusia?
    QuestionOnAnswersBtn:
    - answer:
      - Dengan menyebabkan keradangan
      - Dengan menghasilkan toksin untuk membunuh bakteria jahat
      - Dengan membantu penghadaman dan mensintesis vitamin
      - Dengan memecahkan sel darah merah
      answeOnBtn: 2
